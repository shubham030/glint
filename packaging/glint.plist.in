<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Runs the extended display at login. `glint display` finds the panel itself —
  USB if a cable is in, otherwise the first panel answering on the network — and
  waits for one to appear, so the agent can start before the panel exists.
  KeepAlive restarts it when the panel goes away (the session exits 3 on
  disconnect), which is also how it picks up a board that reboots.

  Install:
    cp packaging/com.glint.display.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.glint.display.plist
  Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.glint.display.plist

  Screen Recording permission belongs to the binary being run, so the first
  launch may need approval in System Settings → Privacy & Security.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.glint.display</string>

    <key>ProgramArguments</key>
    <array>
        <string>@GLINT@</string>
        <string>display</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <!-- Avoid a tight respawn loop if something is fundamentally broken. -->
    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>/tmp/glint.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/glint.log</string>
</dict>
</plist>
