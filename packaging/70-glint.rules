# Lets a normal user open the panel's usbfs node. Without this, the Go host on
# Linux can only run as root: /dev/bus/usb/* is root:root 0664 by default.
#
# Install (on the Linux host, e.g. a Pi):
#   sudo install -m 644 70-glint.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# then replug the panel.
#
# plugdev rather than MODE="0666": world-writable access to a USB device is
# more than this needs, and Raspberry Pi OS already puts the default user in
# plugdev.
SUBSYSTEM=="usb", ATTR{idVendor}=="cafe", ATTR{idProduct}=="4010", GROUP="plugdev", MODE="0660"
